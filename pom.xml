<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>cn.com.keelbase</groupId>
  <artifactId>keelbase-java-starter-parent</artifactId>
  <version>0.2.0</version>
  <packaging>pom</packaging>

  <name>KeelBase Java Starter (Parent)</name>
  <description>Spring Boot starter for connecting Java/Spring systems to KeelBase as governed AI tools (delegated identity, proxy-tool export, compensation endpoints).</description>

  <modules>
    <module>keelbase-tools-annotation</module>
    <module>keelbase-delegation-filter</module>
    <module>keelbase-tools-export</module>
    <module>keelbase-compensation</module>
    <module>keelbase-client</module>
    <module>keelbase-spring-boot-autoconfigure</module>
    <module>keelbase-spring-boot-starter</module>
    <module>keelbase-maven-plugin</module>
    <module>keelbase-test-support</module>
    <module>keelbase-java-example</module>
    <module>keelbase-java-crm-example</module>
    <module>keelbase-java-pm-example</module>
    <module>keelbase-java-approval-example</module>
  </modules>

  <properties>
    <java.version>17</java.version>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spring-boot.version>3.5.16</spring-boot.version>
    <jjwt.version>0.11.5</jjwt.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Pinned ahead of the Boot BOM on purpose: the first import that manages an artifact wins,
           so declaring these first lifts Jackson 2 and Log4j above the versions Boot 3.5.16 ships.
           Boot 3.5.x is the newest line that still runs on Framework 6.2, and 6.2.19 is where that
           line ends — these two are the advisories a version bump can still clear without moving
           to Spring Boot 4. Jackson is imported as a whole BOM rather than artifact by artifact so
           databind, core and the datatype modules cannot drift apart.
           故意排在 Boot BOM 之前：同一个 artifact 由先声明的 import 生效，所以先写这两个就能把
           Jackson 2 与 Log4j 抬到 Boot 3.5.16 自带版本之上。Boot 3.5.x 是仍跑在 Framework 6.2 上的
           最后一条线，而 6.2.19 就是这条线的终点 —— 这两项是不搬去 Spring Boot 4 仍能清掉的公告。
           Jackson 按整份 BOM 导入而不是逐个 artifact，这样 databind、core 与各 datatype 模块不会错位。 -->
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>2.21.7</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.apache.logging.log4j</groupId>
        <artifactId>log4j-bom</artifactId>
        <version>2.25.5</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Tomcat has no BOM of its own, so the embedded artifacts are pinned one by one. 10.1.61
           stays on the 10.1 line Boot 3.5.x targets, which is what makes this a patch-level move
           rather than the container swap Spring Boot 4 performs (it ships Tomcat 11).
           Tomcat 没有自己的 BOM，所以内嵌的那几个 artifact 只能逐个钉。10.1.61 仍在 Boot 3.5.x 所面向的
           10.1 线上，正因如此这是一次补丁级移动，而不是 Spring Boot 4 做的那种容器换代（那边是 Tomcat 11）。 -->
      <dependency>
        <groupId>org.apache.tomcat.embed</groupId>
        <artifactId>tomcat-embed-core</artifactId>
        <version>10.1.61</version>
      </dependency>
      <dependency>
        <groupId>org.apache.tomcat.embed</groupId>
        <artifactId>tomcat-embed-el</artifactId>
        <version>10.1.61</version>
      </dependency>
      <dependency>
        <groupId>org.apache.tomcat.embed</groupId>
        <artifactId>tomcat-embed-websocket</artifactId>
        <version>10.1.61</version>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.jsonwebtoken</groupId>
        <artifactId>jjwt-api</artifactId>
        <version>${jjwt.version}</version>
      </dependency>
      <dependency>
        <groupId>io.jsonwebtoken</groupId>
        <artifactId>jjwt-impl</artifactId>
        <version>${jjwt.version}</version>
      </dependency>
      <dependency>
        <groupId>io.jsonwebtoken</groupId>
        <artifactId>jjwt-jackson</artifactId>
        <version>${jjwt.version}</version>
      </dependency>
      <!-- internal modules -->
      <dependency>
        <groupId>cn.com.keelbase</groupId>
        <artifactId>keelbase-tools-annotation</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.com.keelbase</groupId>
        <artifactId>keelbase-delegation-filter</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.com.keelbase</groupId>
        <artifactId>keelbase-tools-export</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.com.keelbase</groupId>
        <artifactId>keelbase-compensation</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.com.keelbase</groupId>
        <artifactId>keelbase-client</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.com.keelbase</groupId>
        <artifactId>keelbase-spring-boot-autoconfigure</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.com.keelbase</groupId>
        <artifactId>keelbase-spring-boot-starter</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.com.keelbase</groupId>
        <artifactId>keelbase-test-support</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
          <configuration>
            <parameters>true</parameters>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.2.5</version>
        </plugin>
        <!-- 来源指纹（对齐主库 provenance）：每个 jar 内嵌 Implementation-* 元数据，构建产物可溯源 -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.4.1</version>
          <configuration>
            <archive>
              <manifestEntries>
                <Implementation-Title>KeelBase Java Starter</Implementation-Title>
                <Implementation-Version>${project.version}</Implementation-Version>
                <Implementation-Vendor>KeelBase</Implementation-Vendor>
                <Implementation-URL>https://github.com/rain6fish/KeelBase-java-starter</Implementation-URL>
                <Source-URL>https://github.com/rain6fish/KeelBase-java-starter</Source-URL>
                <Build-Jdk-Spec>${java.version}</Build-Jdk-Spec>
                <Build-Timestamp>${maven.build.timestamp}</Build-Timestamp>
              </manifestEntries>
            </archive>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <url>https://github.com/rain6fish/KeelBase-java-starter</url>

  <scm>
    <connection>scm:git:https://github.com/rain6fish/KeelBase-java-starter.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/rain6fish/KeelBase-java-starter.git</developerConnection>
    <tag>HEAD</tag>
    <url>https://github.com/rain6fish/KeelBase-java-starter</url>
  </scm>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>rain6fish</id>
      <name>Rain6fish</name>
    </developer>
  </developers>

  <profiles>
    <!-- Release profile (Central publish; not activated in this round). -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.3.0</version>
            <executions>
              <execution><id>attach-sources</id><goals><goal>jar-no-fork</goal></goals></execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.6.3</version>
            <executions>
              <execution><id>attach-javadocs</id><goals><goal>jar</goal></goals></execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.2</version>
            <configuration>
              <!-- CI 无 pinentry：batch + loopback 从 -Dgpg.passphrase 读 passphrase 签名 -->
              <gpgArguments>
                <arg>--batch</arg>
                <arg>--pinentry-mode</arg>
                <arg>loopback</arg>
              </gpgArguments>
            </configuration>
            <executions>
              <execution><id>sign-artifacts</id><phase>verify</phase>
                <goals><goal>sign</goal></goals>
              </execution>
            </executions>
          </plugin>
          <!-- Maven Central Portal publish (central.sonatype.com). Token from
               settings.xml server "central" (Portal token username/password).
               autoPublish: publish automatically once validated (no manual step). -->
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.9.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>true</autoPublish>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
