<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>cn.com.keelbase</groupId>
  <artifactId>keelbase-java-starter-parent</artifactId>
  <version>0.1.3</version>
  <packaging>pom</packaging>

  <name>KeelBase Java Starter (Parent)</name>
  <description>Spring Boot starter for connecting Java/Spring systems to KeelBase as governed AI tools (delegated identity, proxy-tool export, compensation endpoints).</description>

  <modules>
    <module>keelbase-tools-annotation</module>
    <module>keelbase-delegation-filter</module>
    <module>keelbase-tools-export</module>
    <module>keelbase-compensation</module>
    <module>keelbase-client</module>
    <module>keelbase-spring-boot-autoconfigure</module>
    <module>keelbase-spring-boot-starter</module>
    <module>keelbase-java-example</module>
    <module>keelbase-java-crm-example</module>
    <module>keelbase-java-pm-example</module>
    <module>keelbase-java-approval-example</module>
  </modules>

  <properties>
    <java.version>17</java.version>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spring-boot.version>3.5.16</spring-boot.version>
    <jjwt.version>0.11.5</jjwt.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.jsonwebtoken</groupId>
        <artifactId>jjwt-api</artifactId>
        <version>${jjwt.version}</version>
      </dependency>
      <dependency>
        <groupId>io.jsonwebtoken</groupId>
        <artifactId>jjwt-impl</artifactId>
        <version>${jjwt.version}</version>
      </dependency>
      <dependency>
        <groupId>io.jsonwebtoken</groupId>
        <artifactId>jjwt-jackson</artifactId>
        <version>${jjwt.version}</version>
      </dependency>
      <!-- internal modules -->
      <dependency>
        <groupId>cn.com.keelbase</groupId>
        <artifactId>keelbase-tools-annotation</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.com.keelbase</groupId>
        <artifactId>keelbase-delegation-filter</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.com.keelbase</groupId>
        <artifactId>keelbase-tools-export</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.com.keelbase</groupId>
        <artifactId>keelbase-compensation</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.com.keelbase</groupId>
        <artifactId>keelbase-client</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.com.keelbase</groupId>
        <artifactId>keelbase-spring-boot-autoconfigure</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.com.keelbase</groupId>
        <artifactId>keelbase-spring-boot-starter</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
          <configuration>
            <parameters>true</parameters>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.2.5</version>
        </plugin>
        <!-- 来源指纹（对齐主库 provenance）：每个 jar 内嵌 Implementation-* 元数据，构建产物可溯源 -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.4.1</version>
          <configuration>
            <archive>
              <manifestEntries>
                <Implementation-Title>KeelBase Java Starter</Implementation-Title>
                <Implementation-Version>${project.version}</Implementation-Version>
                <Implementation-Vendor>KeelBase</Implementation-Vendor>
                <Implementation-URL>https://github.com/rain6fish/KeelBase-java-starter</Implementation-URL>
                <Source-URL>https://github.com/rain6fish/KeelBase-java-starter</Source-URL>
                <Build-Jdk-Spec>${java.version}</Build-Jdk-Spec>
                <Build-Timestamp>${maven.build.timestamp}</Build-Timestamp>
              </manifestEntries>
            </archive>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <url>https://github.com/rain6fish/KeelBase-java-starter</url>

  <scm>
    <connection>scm:git:https://github.com/rain6fish/KeelBase-java-starter.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/rain6fish/KeelBase-java-starter.git</developerConnection>
    <tag>HEAD</tag>
    <url>https://github.com/rain6fish/KeelBase-java-starter</url>
  </scm>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>rain6fish</id>
      <name>Rain6fish</name>
    </developer>
  </developers>

  <profiles>
    <!-- Release profile (Central publish; not activated in this round). -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.3.0</version>
            <executions>
              <execution><id>attach-sources</id><goals><goal>jar-no-fork</goal></goals></execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.6.3</version>
            <executions>
              <execution><id>attach-javadocs</id><goals><goal>jar</goal></goals></execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.2</version>
            <configuration>
              <!-- CI 无 pinentry：batch + loopback 从 -Dgpg.passphrase 读 passphrase 签名 -->
              <gpgArguments>
                <arg>--batch</arg>
                <arg>--pinentry-mode</arg>
                <arg>loopback</arg>
              </gpgArguments>
            </configuration>
            <executions>
              <execution><id>sign-artifacts</id><phase>verify</phase>
                <goals><goal>sign</goal></goals>
              </execution>
            </executions>
          </plugin>
          <!-- Maven Central Portal publish (central.sonatype.com). Token from
               settings.xml server "central" (Portal token username/password).
               autoPublish: publish automatically once validated (no manual step). -->
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.9.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>true</autoPublish>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
